          <InfoRow label="\uc0\u1575 \u1604 \u1607 \u1575 \u1578 \u1601 " value=\{client.phone\} />\
          <InfoRow label="\uc0\u1575 \u1604 \u1588 \u1585 \u1603 \u1577 " value=\{client.company\} />\
          <InfoRow label="\uc0\u1575 \u1604 \u1581 \u1575 \u1604 \u1577 " value=\{client.status\} />\
          <InfoRow label="\uc0\u1578 \u1575 \u1585 \u1610 \u1582  \u1575 \u1604 \u1573 \u1590 \u1575 \u1601 \u1577 " value=\{formatDate(client.createdAt)\} />\
          <InfoRow label="\uc0\u1571 \u1590 \u1610 \u1601  \u1576 \u1608 \u1575 \u1587 \u1591 \u1577 " value=\{client.createdBy\} />\
        </div>\
        \{client.notes && (\
          <div className="mt-4 pt-4 border-t border-white/5">\
            <p className="text-white/50 text-sm mb-1">\uc0\u1605 \u1604 \u1575 \u1581 \u1592 \u1575 \u1578 </p>\
