        )\}\
      </div>\
\
      <div className="bg-[#111c2d] rounded-2xl p-6 border border-white/5">\
        <h2 className="text-white font-bold mb-4">\uc0\u1605 \u1607 \u1575 \u1605  \u1575 \u1604 \u1593 \u1605 \u1610 \u1604  (\{clientTasks.length\})</h2>\
        \{clientTasks.length === 0 ? (\
          <p className="text-white/50 text-center py-8">\uc0\u1604 \u1575  \u1578 \u1608 \u1580 \u1583  \u1605 \u1607 \u1575 \u1605  \u1605 \u1585 \u1578 \u1576 \u1591 \u1577  \u1576 \u1607 \u1584 \u1575  \u1575 \u1604 \u1593 \u1605 \u1610 \u1604 </p>\
